# ==============================================================================
# PrepAI Environment Configuration
# ==============================================================================

# Google Gemini API Key (Required for AI Mock Interviews, Feedback & Resume Analysis)
# Get your free key at: https://aistudio.google.com/app/apikey
# In AI Studio, this is automatically injected at runtime from user secrets.
# For local development, replace with your actual API key:
GEMINI_API_KEY="your_gemini_api_key_here"

# Application Base URL
# In AI Studio / Cloud Run, this is automatically injected.
# For local development:
APP_URL="http://localhost:3000"

# Optional: Server Port (Defaults to 3000)
PORT=3000

# Node Environment ('development' | 'production')
NODE_ENV="development"
